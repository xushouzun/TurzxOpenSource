<UserControl x:Class="TURZX.WinUsbDisplay.Studio.PreviewCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    UseLayoutRounding="True">
    <Viewbox x:Name="ScreenScale" Stretch="Uniform" ClipToBounds="True">
        <Canvas x:Name="NativeScreen" ClipToBounds="True">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Background" Value="Black" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Source, ElementName=ForegroundFrame}" Value="{x:Null}" />
                                <Condition Binding="{Binding Source, ElementName=BackgroundFrame}" Value="{x:Null}" />
                                <Condition Binding="{Binding Visibility, ElementName=VideoA}" Value="Collapsed" />
                                <Condition Binding="{Binding Visibility, ElementName=VideoB}" Value="Collapsed" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <MediaElement x:Name="VideoA" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
                          Stretch="Uniform" Visibility="Collapsed" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
            <MediaElement x:Name="VideoB" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
                          Stretch="Uniform" Visibility="Collapsed" MediaOpened="OnMediaOpened" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" />
            <Image x:Name="BackgroundFrame" Stretch="Uniform" />
            <Image x:Name="ForegroundFrame" Stretch="Uniform" />
            <Rectangle x:Name="RegionOutline" Stroke="#53CAFF" StrokeThickness="2" Fill="#2053CAFF"
                       IsHitTestVisible="False" Visibility="Collapsed" />
        </Canvas>
    </Viewbox>
</UserControl>
