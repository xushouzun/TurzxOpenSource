                    <TextBlock Grid.Row="1" Style="{StaticResource Muted}" Margin="0,8,0,12"
                               Text="{DynamicResource L.CodeExampleSetup}" />
                    <TextBox x:Name="PacketExampleCode" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas" MinHeight="160" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{DynamicResource L.CCodeExample}" />
                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button x:Name="PacketExampleClose" DockPanel.Dock="Right" Content="{DynamicResource L.Close}"
                                Click="OnClosePacketExample" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="{DynamicResource L.CopyCode}" Click="OnCopyPacketExample"
                                Background="#A8BFFF" Foreground="#102041" />
                        <TextBlock x:Name="PacketExampleStatus" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
